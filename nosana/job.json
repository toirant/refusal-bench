{
  "version": "0.1",
  "type": "container",
  "meta": {
    "trigger": "cli",
    "system_requirements": {
      "required_vram": 16
    }
  },
  "ops": [
    {
      "type": "container/run",
      "id": "vllm-qwen25-7b",
      "args": {
        "image": "docker.io/vllm/vllm-openai:v0.6.4",
        "cmd": [
          "--model",
          "Qwen/Qwen2.5-7B-Instruct",
          "--served-model-name",
          "Qwen2.5-7B-Instruct",
          "--host",
          "0.0.0.0",
          "--port",
          "8000",
          "--max-model-len",
          "8192",
          "--dtype",
          "auto"
        ],
        "gpu": true,
        "expose": [
          {
            "port": 8000,
            "health_checks": [
              {
                "type": "http",
                "path": "/v1/models",
                "method": "GET",
                "expected_status": 200,
                "continuous": true
              }
            ]
          }
        ]
      }
    }
  ]
}
